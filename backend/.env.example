# Backend Environment Variables Example
# Copy this file to .env and fill in your values for local development.
# For production (Render), enter these exactly in the Render dashboard.

# MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URI=

# Server Port (Render will provide this, locally use 5000)
PORT=5000

# Google Gemini AI Key
GEMINI_API_KEY=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS Allowed Origin (frontend URL)
# In production, set to your Vercel URL (e.g. https://6-astra.vercel.app)
CORS_ORIGIN=http://localhost:3000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OTP Rate Limiting
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT_WINDOW=15
OTP_MAX_REQUESTS=5

# Twilio SMS Configurations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT Secret
JWT_SECRET=

# Third-party APIs
COLLEGEDB_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
