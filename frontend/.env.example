# VITE_API_BASE_URL
# In development, leave empty to use Vite proxy, or set to http://localhost:5000
# In production, set to your Render backend URL (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=

# VITE_PUBLIC_SITE_URL
# In production, set this to your actual deployed public URL (e.g. https://u-think.vercel.app)
# This is used for WhatsApp Share functionality and Link Previews.
VITE_PUBLIC_SITE_URL=https://u-think.vercel.app
